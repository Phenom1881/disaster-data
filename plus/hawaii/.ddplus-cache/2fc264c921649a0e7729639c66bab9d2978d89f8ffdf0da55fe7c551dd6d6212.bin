    	<meta name='robots' content='max-image-preview:large' />

	<meta name="description" content="September 2, 2026: Emergency Proclamation relating to September 2026 Tropical Cyclones. The proclamation suspends Chapter 103D HRS, Hawaii public procurement code, and Chapter 103F, HRS, purchases of health and human services, to the extent that compliance results in any additional delays involved in meeting procurement requirements for selecting contractors in a timely manner to prepare [&hellip;]" />

	<!-- Twitter Card data -->
	<meta name="twitter:card" content="summary">

	<!-- Begin Open Graph data -->
	<meta property="og:title" content="Emergency Proclamations &#8211; Archived" />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://spo.hawaii.gov/emergency-proclamations-archived/" />
	<meta property="og:image" content="https://spo.hawaii.gov/wp-content/themes/hic_state_template_parent/images/og-image.jpg" />
	<meta property="og:description" content="September 2, 2026: Emergency Proclamation relating to September 2026 Tropical Cyclones. The proclamation suspends Chapter 103D HRS, Hawaii public procurement code, and Chapter 103F, HRS, purchases of health and human services, to the extent that compliance results in any additional delays involved in meeting procurement requirements for selecting contractors in a timely manner to prepare [&hellip;]" />
	<!-- End Open Graph data -->

