                     <li><a href="/content/dam/soi/en/web/illinois/documents/government/executive-orders/2021/executiveorder-2021-02-spanish.pdf" target="_blank" aria-label="Executive Order Number 02 Spanish">Spanish</a></li>
                  
                     <li><a href="/content/dam/soi/en/web/illinois/documents/government/executive-orders/2021/executiveorder-2021-02-hindi.pdf" target="_blank" aria-label="Executive Order Number 02 Hindi">Hindi</a></li>
                  
                     <li><a href="/content/dam/soi/en/web/illinois/documents/government/executive-orders/2021/executiveorder-2021-02-polish.pdf" target="_blank" aria-label="Executive Order Number 02 Polish">Polish</a></li>
                  
                     <li><a href="/content/dam/soi/en/web/illinois/documents/government/executive-orders/2021/executiveorder-2021-02-tagalog.pdf" target="_blank" aria-label="Executive Order Number 02 Tagalog">Tagalog</a></li>
                  
               </ul>
            </li>
         
            <li class="cmp-exe-order-feed__item">
               <div class="title">
                  <div class="cmp-title">
                     <h3 class="cmp-title__text">Executive Order Number 01</h3>
                  </div>
               </div>
               <p>REISSUES EXECUTIVE ORDERS — Reissues most executive orders, extending a majority of the provisions through February 6, 2021.</p>
               <ul> 
                  <li>
                  <a href="/government/executive-orders/executive-order.executive-order-number-01.2021.html" aria-label="Executive Order 2021-01(HTML)">Executive Order 2021-01(HTML)</a>
                  
                  </li>
                  
                     <li><a href="/content/dam/soi/en/web/illinois/documents/government/executive-orders/2021/executiveorder-2021-01.pdf" target="_blank" aria-label="Executive Order Number 01 English">English</a></li>
                  
                     <li><a href="/content/dam/soi/en/web/illinois/documents/government/executive-orders/2021/executiveorder-2021-01-arabic.pdf" target="_blank" aria-label="Executive Order Number 01 Arabic">Arabic</a></li>
                  
