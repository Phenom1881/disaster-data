                  <li>
                  <a href="/government/executive-orders/executive-order.executive-order-number-07.2023.html" aria-label="Executive Order 2023-07(HTML)">Executive Order 2023-07(HTML)</a>
                  
                  </li>
                  
                     <li><a href="/content/dam/soi/en/web/illinois/documents/government/executive-orders/2023/executive-order-2023-07.pdf" target="_blank" aria-label="Executive Order 2023-07 English">English</a></li>
                  
                     <li><a href="/content/dam/soi/en/web/illinois/documents/government/executive-orders/2023/executive-order-2023-07-arabic.pdf" target="_blank" aria-label="Executive Order 2023-07 Arabic">Arabic</a></li>
                  
