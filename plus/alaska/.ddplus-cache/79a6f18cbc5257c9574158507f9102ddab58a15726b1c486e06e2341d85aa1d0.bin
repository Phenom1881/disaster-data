  <script>
    var amountScrolled = 300;

    $(window).scroll(function () {
      if ($(window).scrollTop() > amountScrolled) {
        $('a.back-to-top').fadeIn('slow');
      } else {
        $('a.back-to-top').fadeOut('slow');
      }
    });

    $('a.back-to-top').click(function () {
      $('html, body').animate({
        scrollTop: 0
      }, 700);
      return false;
    });

  </script>
  <script>
    $(function () {
      $('div.navbar-header').click(
        function () {
          $(this).next().slideToggle(300);
        });
    });
  </script>

  <script src="/bundles/jquery?v=zflc9VnNfzTg76hrZAEp65JYuhBBPoux7bN1izTz_fs1"></script>

  <script src="/bundles/bootstrap?v=lescQEuG5u4jd-GcVDBcbpUOSyTDIg0Kk9zHDX55GCw1"></script>


  
  <script src="/Scripts/AKGreeting3.js"></script>
  <script src="/Scripts/ResponsiveMenu.js" type="text/javascript"></script>
  <script src="/Scripts/TableHrefFinder.js"></script>


  <script>
    async function checkAndReportBrokenLinks() {
      // Check if the current page is the BrokenLinksReport view (you can modify this condition based on your URL structure)
      if (window.location.pathname.includes("/BrokenLinksReport")) {
        return; // Exit the function if we are on the BrokenLinksReport page
      }

      let links = document.querySelectorAll("a"); // Get all <a> elements on the page
      let brokenLinks = new Set(); // Use a Set to store unique broken links

      // File extensions to check (only document and image files)
      let fileExtensions = [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
        ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".svg"];

      // Query parameters to ignore (tracking parameters)
      let ignoredParams = ["fbclid", "utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content", "gsc.tab", "gsc.ref", "gsc.q", "gsc.page"];

      /**
       * Checks if a URL contains ignored query parameters.
       * param {string} url - The URL to check.
       * returns {boolean} - True if the URL has ignored parameters, otherwise false.
       */
      function hasIgnoredParams(url) {
        try {
          let urlObj = new URL(url, window.location.origin); // Create a URL object (handles relative URLs)
          return ignoredParams.some(param => urlObj.searchParams.has(param)); // Check if any ignored param exists
        } catch {
          return false; // If the URL is invalid, ignore it
        }
      }

      /**
       * Adds a warning icon next to broken links and changes their text color to red.
       * param {HTMLElement} link - The <a> element to mark as broken.
       */
      function markAsBroken(link) {
        if (!link.dataset.broken) { // Avoid adding duplicate icons
          const warning = document.createElement("span");
          warning.textContent = " ⚠️"; // Warning symbol
          warning.style.color = "red"; // Set color to red
          warning.style.marginRight = "5px"; // Add spacing
          link.prepend(warning); // Insert the warning icon before the link text
          link.classList.add("red"); // Add CSS class to color the link text
          link.dataset.broken = "true"; // Mark this link as processed
        }
      }

      // Map all links to fetch (HEAD request) to check for broken links
      let requests = Array.from(links).map(link => {
        let url = link.href.trim().toLowerCase(); // Normalize URL (trim spaces and convert to lowercase)

        // Skip links that:
        // - Are empty
        // - Contain ignored tracking parameters
        // - Do NOT end with one of the specified file extensions
        // - Do NOT start with "https://ready.alaska.gov" or are not relative links to this domain
        if (!url || hasIgnoredParams(url) || !fileExtensions.some(ext => url.endsWith(ext))) {
          return Promise.resolve(); // Skip this link (do nothing)
        }

        // Only process links that start with "https://ready.alaska.gov" or are relative to it
        if (!url.startsWith("https://ready.alaska.gov")) {
          return Promise.resolve(); // Skip this link if it does not start with "https://ready.alaska.gov"
        }

        // If the URL is relative, prepend "https://ready.alaska.gov" to it
        if (!url.startsWith("http://") && !url.startsWith("https://")) {
          url = "https://ready.alaska.gov" + url; // Convert relative URL to absolute URL
        }

        // Send a HEAD request to check if the file exists
        return fetch(url, { method: "HEAD" })
          .then(response => {
            if (!response.ok) { // If the response status is not OK (e.g., 404, 500)
              markAsBroken(link); // Mark the link visually as broken (if not on the report page)
              brokenLinks.add(JSON.stringify({
                pageUrl: window.location.href, // The current page URL
                brokenLink: url, // The broken link URL
                brokenLinkText: link.innerText || "[No Text]" // Get the link text or use a placeholder
              }));
            }
          })
          .catch((error) => { // If there's a network error (e.g., failed to fetch)
            console.log("Error fetching URL:", url, error); // Log the error for debugging
            markAsBroken(link); // Mark the link visually as broken
            brokenLinks.add(JSON.stringify({
              pageUrl: window.location.href, // The current page URL
              brokenLink: url, // The broken link URL
              brokenLinkText: link.innerText || "[No Text]" // Get the link text or use a placeholder
            }));
          });
      });

      // Wait for all requests to complete
      await Promise.all(requests);

      // If any broken links were found, send them to the server
      if (brokenLinks.size > 0) {
        const brokenLinksArray = Array.from(brokenLinks).map(item => JSON.parse(item)); // Convert Set to an array

        try {
          const response = await fetch("/CheckBrokenLinksReport", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(brokenLinksArray) // Send broken links as JSON
          });
        } catch (error) {
          if (!response.ok) {
            console.error("Error sending broken links report:", error);
          }
        }
      }

      // Run the function when the page loads
      window.onload = checkAndReportBrokenLinks;
    }
  </script>

